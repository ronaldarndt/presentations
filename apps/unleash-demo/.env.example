# URL da API do Unleash, incluindo o /api no final.
# Padrão do código: http://localhost:4242/api
UNLEASH_URL=

# Token de cliente (server-side) gerado no Unleash, em Admin > API access.
UNLEASH_API_TOKEN=

# Nome da aplicação que aparece no Unleash.
# Padrão do código: unleash-demo
UNLEASH_APP_NAME=
